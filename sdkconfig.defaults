# Target ESP32
CONFIG_IDF_TARGET="esp32"

# Round 1.75-inch CO5300 display and CST9217 capacitive touch.
# Disable in menuconfig > JustRide display for the original 2.8-inch module.
CONFIG_JUSTRIDE_ROUND_AMOLED=y

# 4MB Flash Size configuration
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Log output level (Info)
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3

# Custom Dual OTA Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Enable Automatic Bootloader Rollback Engine
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Bluetooth BLE Settings (NimBLE stack)
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
